pipeline {
    agent {label 'docker'}

    environment {
        FE_OR_BE = 'be'
        PORT = '5004'
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
        DOCKER_REGISTRY = 'hanilz'
        REPO_NAME = "${FE_OR_BE}-exam"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        PYENV_HOME = "${WORKSPACE}/exam-code/docker/${FE_OR_BE}/.pyenv"
        PROJECT_HOME = "${WORKSPACE}/exam-code/docker/${FE_OR_BE}"
        DOCKER_COMPOSE_DIR = "${WORKSPACE}/exam-code/docker"
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'workshop/argo-jenkins-exam', url: 'https://github.com/hanilz/devopshift-welcome.git'
            }
        }
        
        stage('Lint & Security Scan') {
            parallel (
                'Lint': {
                    dir("${PROJECT_HOME}") {
                        script {
                            // Install flake8 if not available and run
                            sh '''#!/bin/bash
                                if ! command -v flake8 &> /dev/null; then
                                    echo "Installing flake8..."
                                    pip install flake8
                                fi
                                echo 'Running flake8 lint...'
                                flake8 ${PROJECT_HOME}/src
                                echo 'Finished flake8 lint.'
                            '''
                        }
                    }
                },
                'Security Scan': {
                    dir("${PROJECT_HOME}") {
                        script {
                            // Install bandit if not available and run
                            sh '''#!/bin/bash
                                if ! command -v bandit &> /dev/null; then
                                    echo "Installing bandit..."
                                    pip install bandit
                                fi
                                echo 'Running bandit security scan...'
                                bandit -r ${PROJECT_HOME}/src
                                echo 'Finished bandit security scan.'
                            '''
                        }
                    }            
                },
                failFast: true // Stop all parallel stages if any fail
            )
        }

        stage('Install Dependencies') {
            steps {
                dir("${PROJECT_HOME}") {
                    script {
                        // Install virtualenv if not available
                        sh '''#!/bin/bash
                            if ! command -v virtualenv &> /dev/null; then
                                echo "Installing virtualenv..."
                                pip install virtualenv
                            fi

                            # Delete previously built virtualenv and create a new one
                            rm -rf ${PYENV_HOME}
                            virtualenv ${PYENV_HOME}
                            source ${PYENV_HOME}/bin/activate

                            # Install required Python packages
                            pip install -r requirements.txt
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${PROJECT_HOME}") {
                    docker build -t ${DOCKER_REGISTRY}/${REPO_NAME}:${BUILD_NUMBER} .
                    docker tag ${DOCKER_REGISTRY}/${REPO_NAME}:${BUILD_NUMBER} ${DOCKER_REGISTRY}/${REPO_NAME}:latest
                }
            }
        }

        stage('Run Tests in Container') {
            steps {
                docker run --rm ${DOCKER_REGISTRY}/${REPO_NAME}:${BUILD_NUMBER} pytest tests/
            }
        }

        stage('Integration Test with Docker Compose') {
            steps {
                dir("${PROJECT_HOME}") {
                    script {
                        sh '''#!/bin/bash
                            if ! command -v docker-compose &> /dev/null; then
                                echo "Installing docker-compose..."
                                sudo curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
                                sudo chmod +x /usr/local/bin/docker-compose
                            fi

                            docker-compose up -d
                            sleep 10  # Allow services to start
                            curl -f http://localhost:${PORT} || exit 1
                            docker-compose down
                        '''
                    }
                }
            }
        }
        stage('Run Tests in Container') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    echo ${DOCKER_PASS} | docker login -u ${DOCKER_USER} --password-stdin
                    docker push ${DOCKER_REGISTRY}/${REPO_NAME}:${BUILD_NUMBER}
                    docker push ${DOCKER_REGISTRY}/${REPO_NAME}:latest
                }
            }
        }
    }
}
